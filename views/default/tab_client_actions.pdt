<?php /** @var View $this **/ ?>

    <h4><?php $this->_('Solusvm2.tab_client_actions.heading_server_status'); ?></h4>
    <?php
    $status = (isset($server->status) ? $server->status : null);
    $status_class = 'default';
    switch ($status) {
        case 'running':
            $status_class = 'success';
            break;
        case 'stopped':
            $status_class = 'danger';
            break;
        default:
            break;
    }
    $status_label = ($status ? $this->_('Solusvm2.tab_client_actions.status_' . $status, true) : null);
    if (empty($status_label)) {
        $status_label = ($status ?: $this->_('Solusvm2.tab_client_actions.status_unknown', true));
    }
    ?>
    <span class="badge badge-<?php echo $this->Html->safe($status_class); ?> mb-2">
        <i class="fas fa-lightbulb"></i> <?php echo $this->Html->safe($status_label); ?><?php echo !empty($server->is_suspended)
            ? ' (' . $this->Html->safe($this->_('Solusvm2.tab_client_actions.status_suspended', true)) . ')'
            : ''; ?>
    </span>

    <h4><?php $this->_('Solusvm2.tab_client_actions.heading_actions'); ?></h4>
    <div class="row options" id="solusvm2_actions">
        <div class="col-md-4">
            <a<?php echo $status != 'running' ? ' disabled="disabled"' : ''; ?> class="btn btn-success btn-block" href="<?php echo $this->Html->safe(
                $this->base_uri . 'services/manage/' . (isset($service_id) ? $service_id : null) . '/tabClientActions/reboot/',
            ); ?>">
                <i class="fas fa-sync-alt"></i> <?php $this->_('Solusvm2.!actions.reboot'); ?>
            </a>
            <a href="#" class="reinstall btn btn-light btn-block">
                <i class="fas fa-download"></i> <?php $this->_('Solusvm2.!actions.reinstall'); ?>
            </a>
        </div>
        <div class="col-md-4">
            <a<?php echo $status != 'running' ? ' disabled="disabled"' : ''; ?> class="btn btn-danger btn-block" href="<?php echo $this->Html->safe(
                $this->base_uri . 'services/manage/' . (isset($service_id) ? $service_id : null) . '/tabClientActions/shutdown/',
            ); ?>">
                <i class="fas fa-power-off"></i> <?php $this->_('Solusvm2.!actions.shutdown'); ?>
            </a>
            <a<?php echo $status != 'running' ? ' disabled="disabled"' : ''; ?> class="btn btn-danger btn-block" href="<?php echo $this->Html->safe(
                $this->base_uri . 'services/manage/' . (isset($service_id) ? $service_id : null) . '/tabClientActions/poweroff/',
            ); ?>">
                <i class="fas fa-plug"></i> <?php $this->_('Solusvm2.!actions.poweroff'); ?>
            </a>
        </div>
        <div class="col-md-4">
            <a<?php echo $status != 'stopped' ? ' disabled="disabled"' : ''; ?> class="btn btn-light btn-block" href="<?php echo $this->Html->safe(
                $this->base_uri . 'services/manage/' . (isset($service_id) ? $service_id : null) . '/tabClientActions/boot/',
            ); ?>">
                <i class="fas fa-power-off"></i> <?php $this->_('Solusvm2.!actions.boot'); ?>
            </a>
            <a href="#" class="hostname btn btn-light btn-block">
                <i class="fas fa-edit"></i> <?php $this->_('Solusvm2.!actions.hostname'); ?>
            </a>
            <a href="#" class="password btn btn-light btn-block">
                <i class="fas fa-lock"></i> <?php $this->_('Solusvm2.!actions.password'); ?>
            </a>
        </div>
    </div>

    <div class="clearfix"></div>
    <div id="reinstall" style="display:none;">
        <hr />
        <h4><?php $this->_('Solusvm2.tab_client_actions.heading_reinstall'); ?></h4>

        <?php $this->Form->create(
            $this->base_uri . 'services/manage/' . (isset($service_id) ? $service_id : null) . '/tabClientActions/reinstall/',
        ); ?>
        <div class="w-100">
            <?php if (!empty($applications)) { ?>
            <ul class="nav nav-tabs" id="solusvm2_install_tabs" style="margin-bottom:15px;">
                <li class="active"><a href="#" data-solusvm2-tab="os"><?php $this->_('Solusvm2.tab_client_actions.tab_os'); ?></a></li>
                <li><a href="#" data-solusvm2-tab="application"><?php $this->_('Solusvm2.tab_client_actions.tab_application'); ?></a></li>
            </ul>
            <?php } ?>
            <div class="form-group" id="solusvm2_os_tab">
                <?php
                $this->Form->label($this->_('Solusvm2.tab_client_actions.field_os', true), 'os');
                $this->Form->fieldSelect(
                    'os',
                    isset($os_images) ? $os_images : null,
                    isset($vars->os) ? $vars->os : null,
                    ['id' => 'os', 'class' => 'form-control'],
                );
                ?>
            </div>
            <?php if (!empty($applications)) { ?>
            <div class="form-group" id="solusvm2_application_tab" style="display:none;">
                <?php
                $this->Form->label($this->_('Solusvm2.tab_client_actions.field_application', true), 'application');
                $this->Form->fieldSelect(
                    'application',
                    ['' => $this->_('Solusvm2.please_select', true)] + $applications,
                    isset($vars->application) ? $vars->application : null,
                    ['id' => 'application', 'class' => 'form-control', 'disabled' => true],
                );
                ?>
            </div>
            <?php } ?>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <?php
                        $this->Form->fieldCheckbox('confirm', '1', '0', ['id' => 'confirm']);
                        $this->_('Solusvm2.tab_client_actions.field_confirm');
                        ?>
                    </label>
                </div>
            </div>
        </div>
        <button class="btn btn-light float-right">
            <i class="fas fa-download"></i> <?php $this->_('Solusvm2.tab_client_actions.field_reinstall_submit'); ?>
        </button>
        <?php $this->Form->end(); ?>
    </div>

    <div class="clearfix"></div>
    <div id="hostname" style="display:none;">
        <hr />
        <h4><?php $this->_('Solusvm2.tab_client_actions.heading_hostname'); ?></h4>

        <?php $this->Form->create(
            $this->base_uri . 'services/manage/' . (isset($service_id) ? $service_id : null) . '/tabClientActions/hostname/',
        ); ?>
        <div class="w-100">
            <div class="form-group">
                <?php
                $this->Form->label($this->_('Solusvm2.tab_client_actions.field_hostname', true), 'host');
                $this->Form->fieldText('hostname', isset($vars->hostname) ? $vars->hostname : null, [
                    'id' => 'host',
                    'class' => 'form-control',
                    'placeholder' => $this->_('Solusvm2.tab_client_actions.field_hostname', true),
                ]);
                ?>
            </div>
        </div>
        <button class="btn btn-light float-right">
            <i class="fas fa-edit"></i> <?php $this->_('Solusvm2.tab_client_actions.field_hostname_submit'); ?>
        </button>
        <?php $this->Form->end(); ?>
    </div>

    <div class="clearfix"></div>
    <div id="password" style="display:none;">
        <hr />
        <h4><?php $this->_('Solusvm2.tab_client_actions.heading_password'); ?></h4>

        <div class="form-group">
            <?php $this->Form->label($this->_('Solusvm2.tab_client_actions.field_current_password', true), 'current_password'); ?>
            <p><code><?php echo isset($service_fields->solusvm2_root_password)
                ? $this->Html->safe($service_fields->solusvm2_root_password)
                : null; ?></code></p>
        </div>

        <?php $this->Form->create(
            $this->base_uri . 'services/manage/' . (isset($service_id) ? $service_id : null) . '/tabClientActions/password/',
        ); ?>
        <p><?php $this->_('Solusvm2.tab_client_actions.text_password_reset'); ?></p>
        <button class="btn btn-light float-right">
            <i class="fas fa-lock"></i> <?php $this->_('Solusvm2.tab_client_actions.field_password_submit'); ?>
        </button>
        <?php $this->Form->end(); ?>
    </div>

<script type="text/javascript">
$(document).ready(function() {
    setSolusvm2Interval('<?php echo Configure::get('Solusvm2.page_refresh_rate_fast'); ?>', '');
    <?php
    if (isset($reinstall) ? $reinstall : false) { ?>
    showSection('reinstall');
    <?php }
    if (isset($hostname) ? $hostname : false) { ?>
    showSection('hostname');
    <?php }
    if (isset($password) ? $password : false) { ?>
    showSection('password');
    <?php }
    ?>

    $('.options').on('click', 'a.reinstall, a.hostname, a.password', function(e) {
        var item_class = "reinstall";
        if ($(this).hasClass('hostname'))
            item_class = "hostname";
        else if ($(this).hasClass('password'))
            item_class = "password";

        hideSections();
        showSection(item_class);
    });

    $('#solusvm2_install_tabs a').on('click', function(e) {
        e.preventDefault();
        var name = $(this).data('solusvm2-tab');

        $('#solusvm2_install_tabs li').removeClass('active');
        $(this).parent().addClass('active');

        $('#solusvm2_os_tab').toggle(name == 'os');
        $('#solusvm2_application_tab').toggle(name == 'application');
        $('#os').prop('disabled', name != 'os');
        $('#application').prop('disabled', name != 'application');
    });

    function hideSections() {
        $('#reinstall').hide();
        $('#hostname').hide();
        $('#password').hide();
    }

    function showSection(id) {
        $('#' + id).show();
    }

    function setSolusvm2Interval(solusvm2_refresh_rate, solusvm2_old_action_data) {
        var interval = '';
        interval = setInterval(function() {
            $(this).blestaRequest("GET",
                '<?php echo $this->base_uri .
                    'services/manage/' .
                    (isset($service_id) ? $service_id : null) .
                    '/tabClientActions/'; ?>',
                null,
                // Success response
                function(data) {
                    if (data.replacer && data.content) {
                        var html = $('div', data.content).filter('#solusvm2_actions').html();
                        $('#solusvm2_actions').html(html);
                        solusvm2_refresh_rate = (html == solusvm2_old_action_data) ? '<?php echo Configure::get(
                            'Solusvm2.page_refresh_rate',
                        ); ?>' : '<?php echo Configure::get('Solusvm2.page_refresh_rate_fast'); ?>';

                        clearInterval(interval);
                        setSolusvm2Interval(solusvm2_refresh_rate, html);
                    }
                },
                null,
                {dataType: 'json'}
            );
        }, solusvm2_refresh_rate);
    }
});
</script>
