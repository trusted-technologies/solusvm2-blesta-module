<?php /** @var View $this **/ ?>

    <h4><?php $this->_('Solusvm2.tab_client_console.heading_console'); ?></h4>
    <div class="table-responsive">
        <table class="table table-striped">
            <tbody>
                <tr>
                    <td><?php $this->_('Solusvm2.tab_client_console.vnc_password'); ?></td>
                    <td><?php echo isset($console->vnc_password)
                        ? $this->Html->safe($console->vnc_password)
                        : null; ?></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="row">
        <div class="col-md-12">
            <?php if (!empty($console->ws_url)) { ?>
            <script src="<?php echo $this->Html->safe($this->view_dir . 'js/novnc-bundle.js'); ?>"></script>
            <script type="text/javascript">
                $(document).ready(function () {
                    let url = <?php echo json_encode($console->ws_url); ?>;
                    let password = <?php echo json_encode($console->vnc_password); ?>;

                    status('Connecting');

                    let rfb = new RFB(
                        document.getElementById('screen'),
                        url,
                        {
                            credentials: { 'password': password }
                        }
                    );

                    rfb.viewOnly = false;
                    rfb.scaleViewport = true;

                    rfb.addEventListener('connect', function () {
                        status('Connected');
                    });
                    rfb.addEventListener('disconnect', function (e) {
                        status(e.detail.clean ? 'Disconnected' : 'Something went wrong, connection is closed');
                    });

                    $('#sendCtrlAltDelButton').on('click', function () {
                        rfb.sendCtrlAltDel();
                        return false;
                    });

                    $('#pasteClipboardButton').on('click', async function () {
                        try {
                            let text = await navigator.clipboard.readText();
                            rfb.clipboardPasteFrom(text);
                        } catch (err) {
                            alert('Unable to paste: ' + err.message);
                        }
                        return false;
                    });

                    function status(text) {
                        document.getElementById('status').textContent = text;
                    }
                });
            </script>
            <div id="top_bar">
                <div>
                    <span id="status">Loading</span>
                    <button class="btn btn-primary float-right" id="sendCtrlAltDelButton"><?php $this->_(
                        'Solusvm2.tab_client_console.send_ctrlaltdel',
                    ); ?></button>
                    <button class="btn btn-secondary float-right mr-2" id="pasteClipboardButton"><?php $this->_(
                        'Solusvm2.tab_client_console.paste_clipboard',
                    ); ?></button>
                </div>
            </div>
            <div id="screen">
                <!-- This is where the remote screen will appear -->
            </div>
            <?php } else { ?>
            <p class="text-muted"><?php $this->_('Solusvm2.tab_client_console.text_console_unavailable'); ?></p>
            <?php } ?>
        </div>
    </div>
<script type="text/javascript">
    $(document).ready(function () {
      $(this).blestaSetHeadTag("link", {media: "screen", type: "text/css", rel: "stylesheet", href: "<?php echo $this->Html->safe(
          $this->view_dir . 'css/styles.css',
      ); ?>"});
    });
</script>
