<?php
/** @var View $this **/
?>

<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Solusvm2.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . $module->id],
    ],
]);

$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Widget->create($this->_('Solusvm2.add_row.box_title', true));
?>

<h6 class="form-section-header"><?php $this->_('Solusvm2.add_row.basic_title'); ?></h6>

<div class="mb-3">
    <label for="server_name" class="form-label">
        <?php $this->_('Solusvm2.row_meta.server_name'); ?>
    </label>
    <?php $this->Form->fieldText('server_name', $vars->server_name ?? null, [
        'id' => 'server_name',
        'class' => 'form-control',
    ]); ?>
</div>

<div class="mb-3">
    <label for="host" class="form-label">
        <?php $this->_('Solusvm2.row_meta.host'); ?>
    </label>
    <?php $this->Form->fieldText('host', $vars->host ?? null, [
        'id' => 'host',
        'class' => 'form-control',
        'placeholder' => $this->_('Solusvm2.row_meta.host_placeholder', true),
    ]); ?>
</div>

<div class="mb-3">
    <label for="api_token" class="form-label">
        <?php $this->_('Solusvm2.row_meta.api_token'); ?>
    </label>
    <?php $this->Form->fieldText('api_token', $vars->api_token ?? null, ['id' => 'api_token', 'class' => 'form-control']); ?>
    <small class="form-text text-muted"><?php $this->_('Solusvm2.row_meta.api_token_note'); ?></small>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Solusvm2.add_row.add_btn', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>

<?php
$this->Widget->end();
$this->Form->end();
